{
  "_readme": [
    "Two ways to connect Claude Desktop to this MCP server:",
    "",
    "OPTION A — HTTP (server runs separately, Claude connects over network):",
    "  1. Start the server:  python -m src.server",
    "  2. Use the mcpServers block under 'http_client' below.",
    "",
    "OPTION B — stdio (Claude Desktop spawns the process locally):",
    "  Use the mcpServers block under 'stdio' below.",
    "",
    "For Claude Desktop on Windows, config file is at:",
    "  %APPDATA%\\Claude\\claude_desktop_config.json",
    "",
    "For Claude Code (CLI), add to .claude/settings.json or ~/.claude/settings.json"
  ],

  "_OPTION_A_HTTP_paste_this_into_claude_desktop_config": {
    "mcpServers": {
      "local-repo-db": {
        "url": "http://localhost:8000/sse",
        "headers": {
          "Authorization": "Bearer change-me-to-a-strong-secret"
        }
      }
    }
  },

  "_OPTION_B_stdio_paste_this_into_claude_desktop_config": {
    "mcpServers": {
      "local-repo-db": {
        "command": "C:\\Users\\chandresh.zinzala\\workspace\\mcp\\files (1)\\mcp-server\\venv\\Scripts\\python.exe",
        "args": ["-m", "src.server"],
        "cwd": "C:\\Users\\chandresh.zinzala\\workspace\\mcp\\files (1)\\mcp-server",
        "env": {
          "MCP_TRANSPORT":         "stdio",
